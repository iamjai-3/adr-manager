# Elsai Foundry API key (obtain from your Elsai Foundry account)
ELSAI_API_KEY=your-elsai-api-key-here

# Elsai project ID for the ADR Manager prompts
ELSAI_PROJECT_ID=90204511-23f1-4ac0-a14d-098a3acab0d8

# Elsai Foundry API base URL
ELSAI_BASE_URL=https://core.elsaifoundry.ai

# Port to run this FastAPI service on (default: 8000)
PORT=8000

# Prompt cache TTL in seconds (default: 60)
CACHE_TTL_SECONDS=60
